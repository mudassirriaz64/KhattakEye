# Ignore all Markdown files by default
*.md
# Exclude README.md so it remains tracked
!README.md

# Next.js build and cache outputs
.next/
out/
build/

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Environment variables & local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS metadata
.DS_Store
Thumbs.db

# IDE / Editor configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel deployment files
.vercel
